// mpp — front end: MppData's `@Model` and `#Predicate`.
//
// Swift implements these as macros; M++ expands them in the front end:
//
//   @Model final class Trip {            final class Trip: PersistentModel {
//       @Attribute(.unique) var name: String       var name: String
//       var stops: [Stop] = []                     var stops: [Stop] = []
//       init(name: String) { ... }                 init(name: String) { ... }
//   }                                              <generated members> }
//
// The generated members encode and decode the stored properties (values,
// to-one and to-many relationships to other @Model classes), and describe
// unique attributes and cascading relationships. `#Predicate { ... }`
// becomes `Predicate { ... }`, a plain closure. Like every lowering, line
// numbers are kept: everything generated goes on existing lines.

extension Lowerer {
    struct Edit { let start: Int; let end: Int; let text: String }

    struct ModelProperty {
        let name: String
        let type: String            // as written ("" when inferred)
        let isLet: Bool
        let hasDefault: Bool
        var relationship: Relationship = .none
        var cascade = false
        var model = ""              // related model's name
        enum Relationship { case none, toOne, toOneOptional, toMany }
    }

    /// Expands @Model classes and #Predicate. nil: nothing to do.
    mutating func expandModels() -> String? {
        let src = String(decoding: s, as: UTF8.self)
        guard src.contains("@Model") || src.contains("#Predicate") else { return nil }
        let toks = tokens(0, n)
        var edits: [Edit] = []

        func blank(_ a: Int, _ b: Int) {   // spaces, keeping newlines
            edits.append(Edit(start: a, end: b, text: String(s[a ..< b].map { $0 == 10 ? "\n" : " " })))
        }

        // Every @Model class name in this file (relationships are recognized by them).
        var models = Set<String>()
        for k in toks.indices where toks[k].text == "@" && k + 1 < toks.count && toks[k + 1].text == "Model" {
            var j = k + 2
            while j < toks.count && toks[j].text != "class" { j += 1 }
            if j + 1 < toks.count { models.insert(toks[j + 1].text) }
        }

        for k in toks.indices {
            if toks[k].text == "#" && k + 1 < toks.count && toks[k + 1].text == "Predicate" && toks[k + 1].start == toks[k].end {
                edits.append(Edit(start: toks[k].start, end: toks[k + 1].end, text: "Predicate "))
                continue
            }
            guard toks[k].text == "@", k + 1 < toks.count, toks[k + 1].text == "Model", toks[k + 1].start == toks[k].end else { continue }
            var j = k + 2
            while j < toks.count && toks[j].text != "class" && toks[j].text != "{" { j += 1 }
            guard j + 1 < toks.count, toks[j].text == "class" else { continue }
            let name = toks[j + 1].text
            var b = j + 2
            while b < toks.count && toks[b].text != "{" { b += 1 }
            guard b < toks.count else { continue }
            let end = balanced(toks[b].start)
            guard end > 0 else { continue }
            blank(toks[k].start, toks[k + 1].end)
            let inherits = toks[(j + 2) ..< b].contains { $0.text == ":" }
            edits.append(Edit(start: toks[b].start, end: toks[b].start, text: inherits ? ", PersistentModel " : ": PersistentModel "))

            // Stored properties at the class's top level.
            var props: [ModelProperty] = []
            var unique: [String] = []
            var depth = 0
            var m = b + 1
            var transient = false, isUnique = false, cascade = false
            let bodyEndTok = toks.lastIndex { $0.start == end - 1 } ?? toks.count
            while m < bodyEndTok {
                let t = toks[m].text
                if t == "{" || t == "(" || t == "[" { depth += 1; m += 1; continue }
                if t == "}" || t == ")" || t == "]" { depth -= 1; m += 1; continue }
                guard depth == 0 else { m += 1; continue }
                if t == "@" && m + 1 < bodyEndTok {
                    let attr = toks[m + 1].text
                    var e = m + 2
                    if e < bodyEndTok && toks[e].text == "(" && toks[e].start == toks[m + 1].end {
                        let close = balanced(toks[e].start)
                        let inside = text(toks[e].start, close)
                        if attr == "Attribute" && inside.contains(".unique") { isUnique = true }
                        if attr == "Relationship" && inside.contains(".cascade") { cascade = true }
                        while e < bodyEndTok && toks[e].start < close { e += 1 }
                    }
                    if attr == "Transient" { transient = true }
                    if ["Attribute", "Relationship", "Transient"].contains(attr) {
                        blank(toks[m].start, toks[e - 1].end)
                    }
                    m = e
                    continue
                }
                if t == "static" || t == "class" && m + 1 < bodyEndTok && ["var", "let", "func"].contains(toks[m + 1].text) || t == "lazy" {
                    transient = true      // not stored per instance (or not eagerly)
                    m += 1
                    continue
                }
                if (t == "var" || t == "let"), m + 1 < bodyEndTok, Lowerer.identStart(toks[m + 1].text.utf8.first ?? 0) {
                    let pname = toks[m + 1].text
                    var e = m + 2
                    var type = ""
                    let line = lineOf(toks[m].start)
                    if e < bodyEndTok && toks[e].text == ":" {
                        var d = 0
                        var parts: [String] = []
                        e += 1
                        while e < bodyEndTok {
                            let x = toks[e].text
                            if d == 0 && (x == "=" || x == "{" || x == ";" || lineOf(toks[e].start) != line) { break }
                            if x == "[" || x == "(" || x == "<" { d += 1 } else if x == "]" || x == ")" || x == ">" { d -= 1 }
                            parts.append(x)
                            e += 1
                        }
                        type = parts.joined()
                    }
                    var hasDefault = false
                    if e < bodyEndTok && toks[e].text == "=" {
                        hasDefault = true
                        var d = 0
                        e += 1
                        while e < bodyEndTok {
                            let x = toks[e].text
                            if x == "(" || x == "[" || x == "{" { d += 1 } else if x == ")" || x == "]" || x == "}" { d -= 1 }
                            if d < 0 || (d == 0 && (x == ";" || lineOf(toks[e].start) != line) && e > m + 3) { break }
                            e += 1
                        }
                        // A trailing `{` on the same line after a default starts observers.
                    }
                    // `{` right after: computed property, unless it holds willSet/didSet.
                    var stored = true
                    if e < bodyEndTok && toks[e].text == "{" && lineOf(toks[e].start) == line {
                        let first = e + 1 < bodyEndTok ? toks[e + 1].text : ""
                        stored = first == "willSet" || first == "didSet"
                    }
                    if stored && !transient && !pname.hasPrefix("_mpp") {
                        var p = ModelProperty(name: pname, type: type, isLet: t == "let", hasDefault: hasDefault)
                        let base = type.filter { $0 != "?" && $0 != "!" }
                        if type.hasPrefix("["), type.hasSuffix("]"), models.contains(String(type.dropFirst().dropLast())) {
                            p.relationship = .toMany; p.model = String(type.dropFirst().dropLast())
                        } else if models.contains(base) {
                            p.relationship = type.hasSuffix("?") || type.hasSuffix("!") ? .toOneOptional : .toOne
                            p.model = base
                        }
                        p.cascade = cascade
                        props.append(p)
                        if isUnique { unique.append(pname) }
                    }
                    transient = false; isUnique = false; cascade = false
                    m = e
                    continue
                }
                if t == "func" || t == "init" || t == "subscript" || t == "case" || t == "struct" || t == "enum" {
                    transient = false; isUnique = false; cascade = false
                }
                m += 1
            }

            // Generated members, appended on the line of the closing brace.
            var initLines: [String] = [], encode: [String] = [], reload: [String] = [], cascades: [String] = []
            for p in props {
                let q = "\"\(p.name)\""
                switch p.relationship {
                case .none:
                    if !(p.isLet && p.hasDefault) { initLines.append("self.\(p.name) = r.get(\(q))") }
                    encode.append("r.set(\(q), \(p.name))")
                    if !p.isLet { reload.append("\(p.name) = r.get(\(q))") }
                case .toOne:
                    initLines.append("self.\(p.name) = r.requiredModel(\(q))")
                    encode.append("r.setModel(\(q), \(p.name))")
                    if !p.isLet { reload.append("\(p.name) = r.requiredModel(\(q))") }
                    if p.cascade { cascades.append("c.append(\(p.name))") }
                case .toOneOptional:
                    if !(p.isLet && p.hasDefault) { initLines.append("self.\(p.name) = nil") }
                    encode.append("r.setModel(\(q), \(p.name))")
                    if !p.isLet { reload.append("\(p.name) = r.model(\(q))") }
                    if p.cascade { cascades.append("if let x = \(p.name) { c.append(x) }") }
                case .toMany:
                    if !(p.isLet && p.hasDefault) { initLines.append("self.\(p.name) = []") }
                    encode.append("r.setModels(\(q), \(p.name))")
                    if !p.isLet { reload.append("\(p.name) = r.models(\(q))") }
                    if p.cascade { cascades.append("for x in \(p.name) { c.append(x) }") }
                }
            }
            let uniqueList = unique.map { "\"\($0)\"" }.joined(separator: ", ")
            var gen = "public var _mppState = _MppModelState(); "
            gen += "public class var _mppEntity: String { \"\(name)\" }; "
            gen += "public class var _mppUnique: [String] { [\(uniqueList)] }; "
            gen += "public required init(_mppRecord r: _MppRecord) { " + initLines.map { $0 + "; " }.joined() + "}; "
            gen += "public func _mppEncode(_ r: inout _MppRecord) { " + encode.map { $0 + "; " }.joined() + "}; "
            gen += "public func _mppReload(_ r: _MppRecord) { " + reload.map { $0 + "; " }.joined() + "}; "
            gen += cascades.isEmpty ? "public func _mppCascade() -> [any PersistentModel] { [] } "
                : "public func _mppCascade() -> [any PersistentModel] { var c: [any PersistentModel] = []; "
                    + cascades.map { $0 + "; " }.joined() + "return c } "
            var p = end - 2
            while p > toks[b].start && (s[p] == 32 || s[p] == 9) { p -= 1 }
            let needsSep = !(s[p] == 10 || s[p] == 123 || s[p] == 125 || s[p] == 59)
            edits.append(Edit(start: end - 1, end: end - 1, text: (needsSep ? "; " : "") + gen))
        }
        guard !edits.isEmpty else { return nil }
        var out = [UInt8]()
        out.reserveCapacity(n + edits.count * 200)
        var last = 0
        for e in edits.sorted(by: { $0.start < $1.start || ($0.start == $1.start && $0.end < $1.end) }) {
            guard e.start >= last else { continue }
            out += s[last ..< e.start]
            out += Array(e.text.utf8)
            last = e.end
        }
        out += s[last ..< n]
        return String(decoding: out, as: UTF8.self)
    }
}
