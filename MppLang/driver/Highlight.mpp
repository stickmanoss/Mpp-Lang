// mpp — syntax coloring in Xcode's style (`mpp highlight`, and code quoted
// in compiler errors when stderr is a terminal).
//
//   mpp highlight file.mpp            24-bit color for the terminal
//   mpp highlight --html file.mpp     a standalone HTML page
//
// Colors are Xcode's default dark theme: keywords pink, strings red,
// numbers yellow, comments gray, attributes brown, `#` directives orange,
// types and functions from Swift, SwiftUI and the M++ libraries purple,
// your own types teal and your own functions green.

enum TokenKind { case plain, keyword, string, number, comment, attribute, directive, systemType, userType, systemCall, userCall, member, declaration }

enum Highlighter {
    static let keywords: Set<String> = [
        "associatedtype", "class", "deinit", "enum", "extension", "fileprivate", "func", "import", "init", "inout",
        "internal", "let", "open", "operator", "private", "precedencegroup", "protocol", "public", "rethrows", "static",
        "struct", "subscript", "typealias", "var", "break", "case", "catch", "continue", "default", "defer", "do",
        "else", "fallthrough", "for", "guard", "if", "in", "repeat", "return", "throw", "switch", "where", "while",
        "as", "Any", "await", "false", "is", "nil", "self", "Self", "super", "throws", "true", "try", "async",
        "some", "any", "consuming", "borrowing", "mutating", "nonmutating", "override", "final", "lazy", "weak",
        "unowned", "convenience", "required", "optional", "indirect", "dynamic", "nonisolated", "isolated", "actor",
        "macro", "package", "sending", "discard", "copy", "consume", "each", "repeat", "get", "set", "willSet", "didSet",
        // M++
        "place", "unplace", "serial", "parallel",
    ]

    static let swiftTypes: Set<String> = [
        "Int", "Int8", "Int16", "Int32", "Int64", "UInt", "UInt8", "UInt16", "UInt32", "UInt64", "Float", "Float16",
        "Double", "Bool", "String", "Character", "Substring", "Array", "Dictionary", "Set", "Optional", "Result",
        "Range", "ClosedRange", "Never", "Void", "Error", "Equatable", "Hashable", "Comparable", "Codable", "Sendable",
        "Sequence", "Collection", "IteratorProtocol", "Identifiable", "CustomStringConvertible", "Task", "MainActor",
        "UnsafePointer", "UnsafeMutablePointer", "UnsafeRawPointer", "UnsafeMutableRawPointer", "UnsafeBufferPointer",
        "UnsafeMutableBufferPointer", "ContinuousClock", "Duration", "KeyPath", "WritableKeyPath", "Mirror",
        "SIMD2", "SIMD3", "SIMD4", "SIMD8", "SIMD16", "Date", "URL", "Data", "UUID", "CGFloat", "CGPoint", "CGSize", "CGRect",
        // M++ libraries
        "Arena", "Pool", "Unique", "Memory", "File", "FS", "BufferedWriter", "TokenReader", "ByteWriter", "ByteReader",
        "MappedFile", "Bits", "MppDictionary", "MppSet", "FlatHashMap", "FlatHashSet", "Matrix", "Mat", "JSON", "Parallel",
        "RingBuffer", "BitSet", "SmallArray", "PCG32", "Xoshiro256", "CommandLineParser", "TokenFile", "TokenWriter",
        "Tensor", "Accelarate", "Engine", "ModelContainer", "ModelContext", "ModelConfiguration", "FetchDescriptor",
        "Predicate", "PersistentModel", "PersistentIdentifier", "ModelValue", "Linear", "Sequential", "Adam", "SGD",
        "Card", "MppButton", "MppTextField", "Bar", "Pill",
    ]

    static let swiftFunctions: Set<String> = [
        "print", "debugPrint", "dump", "min", "max", "abs", "zip", "stride", "precondition", "preconditionFailure",
        "assert", "assertionFailure", "fatalError", "type", "withUnsafePointer", "withUnsafeMutablePointer",
        "withUnsafeBytes", "readLine", "sqrt", "exp", "log", "sin", "cos", "tan", "pow", "floor", "ceil", "round",
        "map", "filter", "reduce", "compactMap", "flatMap", "sorted", "sort", "append", "insert", "remove", "contains",
        "first", "last", "count", "isEmpty", "joined", "split", "enumerated", "reversed", "forEach", "allSatisfy",
        "app", "format", "println", "benchmark", "matmul", "relu", "sigmoid", "tanh", "sum", "mean", "dot",
    ]

    /// SwiftUI names (from MppLang/editors/symbols), loaded once.
    static let swiftUI: (types: Set<String>, modifiers: Set<String>) = {
        guard let home = Locations.home else { return ([], []) }
        func words(_ file: String) -> Set<String> {
            guard let text = try? Files.read(Path.join(home, "MppLang/editors/symbols/" + file)) else { return [] }
            var out = Set<String>()
            for line in text.split(separator: "\n") where !line.hasPrefix("#") {
                for w in line.split(separator: " ") { out.insert(String(w)) }
            }
            return out
        }
        return (words("SwiftUI-types.txt"), words("SwiftUI-modifiers.txt"))
    }()

    struct Span { let kind: TokenKind; let range: Range<Int> }

    /// Splits source into colored spans.
    static func lex(_ text: String) -> [Span] {
        let s = Array(text.utf8)
        let n = s.count
        var spans: [Span] = []
        var i = 0
        var prevWord = ""          // last identifier/keyword seen (for declarations)
        var prevSig: UInt8 = 0     // last non-space byte
        func isIdent(_ c: UInt8) -> Bool { Lowerer.identChar(c) }
        func emit(_ k: TokenKind, _ a: Int, _ b: Int) { if b > a { spans.append(Span(kind: k, range: a ..< b)) } }

        // Strings, with \( ... ) interpolations colored as code.
        func string(_ start: Int) -> Int {
            var j = start
            let triple = j + 2 < n && s[j + 1] == 34 && s[j + 2] == 34
            j += triple ? 3 : 1
            var segment = start
            while j < n {
                if s[j] == 92 && j + 1 < n && s[j + 1] == 40 {        // \(
                    emit(.string, segment, j + 2)
                    var depth = 1, k = j + 2
                    while k < n && depth > 0 { if s[k] == 40 { depth += 1 } else if s[k] == 41 { depth -= 1 }; if depth > 0 { k += 1 } }
                    let inner = String(decoding: s[(j + 2) ..< k], as: UTF8.self)
                    for sp in lex(inner) { spans.append(Span(kind: sp.kind, range: (sp.range.lowerBound + j + 2) ..< (sp.range.upperBound + j + 2))) }
                    segment = k
                    j = k + 1
                    continue
                }
                if s[j] == 92 { j += 2; continue }
                if !triple && s[j] == 10 { break }
                if s[j] == 34 {
                    if !triple { j += 1; break }
                    if j + 2 < n && s[j + 1] == 34 && s[j + 2] == 34 { j += 3; break }
                }
                j += 1
            }
            emit(.string, segment, Swift.min(j, n))
            return Swift.min(j, n)
        }

        while i < n {
            let c = s[i]
            if c == 47 && i + 1 < n && s[i + 1] == 47 {                     // // comment
                var j = i
                while j < n && s[j] != 10 { j += 1 }
                emit(.comment, i, j); i = j; continue
            }
            if c == 47 && i + 1 < n && s[i + 1] == 42 {                     // /* comment */ (nested)
                var j = i + 2, depth = 1
                while j < n && depth > 0 {
                    if s[j] == 47 && j + 1 < n && s[j + 1] == 42 { depth += 1; j += 2 }
                    else if s[j] == 42 && j + 1 < n && s[j + 1] == 47 { depth -= 1; j += 2 }
                    else { j += 1 }
                }
                emit(.comment, i, j); i = j; continue
            }
            if c == 34 { i = string(i); prevSig = 34; continue }
            if c >= 48 && c <= 57 {
                var j = i + 1
                while j < n && (isIdent(s[j]) || (s[j] == 46 && j + 1 < n && s[j + 1] >= 48 && s[j + 1] <= 57)) { j += 1 }
                emit(.number, i, j); i = j; prevSig = 48; continue
            }
            if c == 64 || c == 35 {                                         // @attribute, #directive
                var j = i + 1
                while j < n && isIdent(s[j]) { j += 1 }
                emit(c == 64 ? .attribute : .directive, i, j); i = j; prevSig = c; continue
            }
            if Lowerer.identStart(c) || c == 96 {
                var j = i + 1
                while j < n && (isIdent(s[j]) || (c == 96 && s[j] != 96)) { j += 1 }
                if c == 96 && j < n { j += 1 }
                let word = String(decoding: s[i ..< j], as: UTF8.self)
                var k = j
                while k < n && (s[k] == 32 || s[k] == 9) { k += 1 }
                let next: UInt8 = k < n ? s[k] : 0
                let kind: TokenKind
                if keywords.contains(word) && prevSig != 46 {
                    kind = .keyword
                } else if ["func", "var", "let", "class", "struct", "enum", "protocol", "case", "typealias", "actor"].contains(prevWord) {
                    kind = .declaration
                } else if let f = word.utf8.first, f >= 65 && f <= 90 {
                    kind = swiftTypes.contains(word) || swiftUI.types.contains(word) ? .systemType : .userType
                } else if next == 40 || (next == 123 && prevSig == 46) {
                    kind = swiftFunctions.contains(word) || swiftUI.modifiers.contains(word) ? .systemCall : .userCall
                } else if prevSig == 46 {
                    kind = swiftUI.modifiers.contains(word) || swiftFunctions.contains(word) ? .systemCall : .member
                } else {
                    kind = .plain
                }
                emit(kind, i, j)
                prevWord = word
                prevSig = s[j - 1]
                i = j
                continue
            }
            var j = i + 1
            while j < n && !Lowerer.identStart(s[j]) && !(s[j] >= 48 && s[j] <= 57) && s[j] != 34 && s[j] != 47 && s[j] != 64 && s[j] != 35 && s[j] != 96 { j += 1 }
            emit(.plain, i, j)
            for b in s[i ..< j] where b != 32 && b != 9 && b != 10 { prevSig = b }
            if s[i ..< j].contains(where: { $0 != 32 && $0 != 9 && $0 != 10 }) { prevWord = "" }
            i = j
        }
        return spans
    }

    /// Xcode default (dark) colors.
    static func rgb(_ k: TokenKind) -> (Int, Int, Int)? {
        switch k {
        case .plain: return nil
        case .keyword: return (0xFC, 0x5F, 0xA3)
        case .string: return (0xFC, 0x6A, 0x5D)
        case .number: return (0xD0, 0xBF, 0x69)
        case .comment: return (0x6C, 0x79, 0x86)
        case .attribute: return (0xBF, 0x85, 0x55)
        case .directive: return (0xFD, 0x8F, 0x3F)
        case .systemType: return (0xD0, 0xA8, 0xFF)
        case .userType: return (0x5D, 0xD8, 0xFF)
        case .systemCall: return (0xA1, 0x67, 0xE6)
        case .userCall: return (0x67, 0xB7, 0xA4)
        case .member: return (0x67, 0xB7, 0xA4)
        case .declaration: return (0x41, 0xA1, 0xC0)
        }
    }

    static func ansi(_ text: String) -> String {
        let bytes = Array(text.utf8)
        var out = ""
        var last = 0
        for sp in lex(text) {
            if sp.range.lowerBound > last { out += String(decoding: bytes[last ..< sp.range.lowerBound], as: UTF8.self) }
            let piece = String(decoding: bytes[sp.range], as: UTF8.self)
            if let (r, g, b) = rgb(sp.kind) {
                let bold = sp.kind == .keyword ? "1;" : ""
                // Color each line separately so pagers and terminals keep it.
                out += piece.split(separator: "\n", omittingEmptySubsequences: false)
                    .map { $0.isEmpty ? "" : "\u{1B}[\(bold)38;2;\(r);\(g);\(b)m\($0)\u{1B}[0m" }
                    .joined(separator: "\n")
            } else {
                out += piece
            }
            last = sp.range.upperBound
        }
        if last < bytes.count { out += String(decoding: bytes[last...], as: UTF8.self) }
        return out
    }

    static func html(_ text: String, title: String) -> String {
        func esc<S: StringProtocol>(_ s: S) -> String {
            var o = ""
            for ch in s {
                switch ch { case "<": o += "&lt;"; case ">": o += "&gt;"; case "&": o += "&amp;"; default: o.append(ch) }
            }
            return o
        }
        let bytes = Array(text.utf8)
        var body = ""
        var last = 0
        for sp in lex(text) {
            if sp.range.lowerBound > last { body += esc(String(decoding: bytes[last ..< sp.range.lowerBound], as: UTF8.self)) }
            let piece = esc(String(decoding: bytes[sp.range], as: UTF8.self))
            if let (r, g, b) = rgb(sp.kind) {
                body += "<span style=\"color:#" + [r, g, b].map { hex2($0) }.joined() + (sp.kind == .keyword ? ";font-weight:600" : "") + "\">" + piece + "</span>"
            } else {
                body += piece
            }
            last = sp.range.upperBound
        }
        if last < bytes.count { body += esc(String(decoding: bytes[last...], as: UTF8.self)) }
        return """
        <!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>\(esc(title))</title>
        <style>body{margin:0;background:#1F1F24;color:#FFFFFFD9}pre{margin:0;padding:20px;font:13px/1.5 "SF Mono",Menlo,Consolas,monospace;tab-size:4;overflow-x:auto}</style>
        </head><body><pre>\(body)</pre></body></html>

        """
    }

    static func hex2(_ v: Int) -> String {
        let d = Array("0123456789ABCDEF")
        return String([d[v >> 4], d[v & 15]])
    }
}

func highlightCommand(_ args: [String]) throws(DriverError) -> Int32 {
    var html = false
    var files: [String] = []
    for a in args {
        if a == "--html" { html = true } else if a.hasPrefix("-") { throw DriverError("unknown option \(a) (usage: mpp highlight [--html] <file>...)") } else { files.append(a) }
    }
    guard !files.isEmpty else { throw DriverError("usage: mpp highlight [--html] <file>...") }
    for f in files {
        let text = try Files.read(f)
        writeStdout(html ? Highlighter.html(text, title: Path.basename(f)) : Highlighter.ansi(text))
    }
    return 0
}
