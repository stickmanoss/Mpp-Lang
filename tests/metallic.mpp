// Metallic tests (part of `make test`).
import Metallic
#if canImport(Darwin)
import Darwin
#else
import Glibc
#endif

struct Params { var scale: Float; var offset: Float }

@kernel func affine(_ input: [Float] [[buffer(0)]],
                    _ p: Params [[buffer(1)]],
                    _ out: texture2d<float> [[texture(0)]],
                    _ gid: uint2 [[thread_position_in_grid]]) {
    let i = Int(gid.y) * Int(out.get_width()) + Int(gid.x)
    out.write(float4(input[i] * p.scale + p.offset), gid)
}

struct Quad { var position: float4 [[position]]; var shade: Float }

@vertex func fullscreen(_ id: uint [[vertex_id]]) -> Quad {
    let xy = float2(id & 1 == 0 ? -1 : 1, id & 2 == 0 ? -1 : 1)
    return Quad(position: float4(xy, 0, 1), shade: id & 1 == 0 ? 0 : 1)       // 0 at left, 1 at right
}

@fragment func gradient(_ q: Quad [[stage_in]]) -> float4 { float4(q.shade, 0, 0, 1) }

let device = MetallicCreateSystemDefaultDevice()!
let queue = device.makeCommandQueue()!
let d = MetallicTextureDescriptor.texture2DDescriptor(pixelFormat: .rgba32Float, width: 64, height: 32, mipmapped: false)
let out = device.makeTexture(descriptor: d)!

// Compute: every texel = input * 2 + 1.
let input = (0 ..< 64 * 32).map { Float($0) }
let cb = queue.makeCommandBuffer()!
let ce = cb.makeComputeCommandEncoder()!
ce.setComputePipelineState(try device.makeComputePipelineState(function: affineFunction))
ce.setBuffer(input, index: 0)
ce.setBytes(Params(scale: 2, offset: 1), index: 1)
ce.setTexture(out, index: 0)
ce.dispatchThreads(MetallicSize(width: 64, height: 32), threadsPerThreadgroup: MetallicSize(width: 8, height: 8))
ce.endEncoding()
cb.commit()
precondition(cb.status == .completed)
for i in [0, 1, 63, 64, 2047] {
    precondition(out.read(i % 64, i / 64).x == Float(i) * 2 + 1, "kernel result at \(i)")
}

// Render: a full-screen quad, red interpolated left to right.
var rd = MetallicRenderPipelineDescriptor()
rd.vertexFunction = fullscreenFunction
rd.fragmentFunction = gradientFunction
let cb2 = queue.makeCommandBuffer()!
var pass = MetallicRenderPassDescriptor()
pass.colorAttachments[0].texture = out
pass.colorAttachments[0].loadAction = .clear
let re = cb2.makeRenderCommandEncoder(descriptor: pass)!
re.setRenderPipelineState(try device.makeRenderPipelineState(descriptor: rd))
re.drawPrimitives(type: .triangleStrip, vertexStart: 0, vertexCount: 4)
re.endEncoding()
cb2.commit()
precondition(cb2.status == .completed)
let left = out.read(0, 16).x, mid = out.read(32, 16).x, right = out.read(63, 16).x
precondition(left < 0.02 && abs(mid - 0.5) < 0.02 && right > 0.98, "interpolation: \(left) \(mid) \(right)")

// Shader math matches Metal.
precondition(smoothstep(0, 1, 0.5) == 0.5 && fract(Float(1.25)) == 0.25 && dot(float3(1, 2, 3), float3(4, 5, 6)) == 32)
precondition(float4(float3(1, 2, 3), 4).zw == float2(3, 4) && length(float2(3, 4)) == 5)

// Shaders compiled to C++ (the default) give the M++ results: uniforms,
// helpers, loops, branches, swizzles and sampling.
struct Tone { var gain: Float; var bias: float3; var invert: Bool }
func shaped(_ x: Float, _ k: Float) -> Float { x * x * (3 - 2 * x) * k }
@kernel func tone(_ src: texture2d<float> [[texture(0)]],
                  _ dst: texture2d<float> [[texture(1)]],
                  _ t: Tone [[buffer(0)]],
                  _ s: sampler [[sampler(0)]],
                  _ gid: uint2 [[thread_position_in_grid]]) {
    let uv = (float2(gid) + 0.5) / float2(Float(dst.get_width()), Float(dst.get_height()))
    var c = src.sample(s, uv).rgb
    for _ in 0 ..< 2 { c = c * t.gain + t.bias }
    if t.invert { c = 1 - c }
    let k = shaped(saturate(c.x), 2)
    dst.write(float4(c.zyx, k), gid)
}
func toneReference(_ v: float3, _ t: Tone) -> float4 {
    var c = v
    for _ in 0 ..< 2 { c = c * t.gain + t.bias }
    if t.invert { c = 1 - c }
    let x = min(max(c.x, 0), 1)
    return float4(c.z, c.y, c.x, x * x * (3 - 2 * x) * 2)
}
let small = MetallicTextureDescriptor.texture2DDescriptor(pixelFormat: .rgba32Float, width: 8, height: 8, mipmapped: false)
let srcT = device.makeTexture(descriptor: small)!, dstT = device.makeTexture(descriptor: small)!
for y in 0 ..< 8 { for x in 0 ..< 8 { srcT.write(float4(Float(x) / 8, Float(y) / 8, 0.25, 1), uint2(uint(x), uint(y))) } }
let toneParams = Tone(gain: 0.75, bias: float3(0.1, -0.05, 0.2), invert: true)
let cb3 = queue.makeCommandBuffer()!
let ke = cb3.makeComputeCommandEncoder()!
ke.setComputePipelineState(try device.makeComputePipelineState(function: toneFunction))
ke.setTexture(srcT, index: 0)
ke.setTexture(dstT, index: 1)
ke.setBytes(toneParams, index: 0)
ke.setSamplerState(.nearest, index: 0)
ke.dispatchThreads(MetallicSize(width: 8, height: 8), threadsPerThreadgroup: MetallicSize(width: 8, height: 8))
ke.endEncoding()
cb3.commit()
precondition(cb3.status == .completed)
for y in 0 ..< 8 {
    for x in 0 ..< 8 {
        let want = toneReference(float3(Float(x) / 8, Float(y) / 8, 0.25), toneParams), got = dstT.read(x, y)
        precondition(abs(got - want).max() < 1e-5, "tone at \(x),\(y): \(got) vs \(want)")
    }
}
if getenv("MPP_METALLIC_NATIVE").map({ String(cString: $0) }) != "0" {
    precondition(toneFunction.isNative && gradientFunction.isNative, "these shaders compile to C++")
    precondition(!affineFunction.isNative, "array buffers stay in M++")
}

// Mismatched stage_in types are reported, not crashed on.
struct Other { var position: float4 [[position]]; var t: Float }
@fragment func wrongInput(_ o: Other [[stage_in]]) -> float4 { float4(o.t) }
var bad = MetallicRenderPipelineDescriptor()
bad.vertexFunction = fullscreenFunction
bad.fragmentFunction = wrongInputFunction
do { _ = try device.makeRenderPipelineState(descriptor: bad); preconditionFailure("expected an error") } catch {}

print("Metallic: all tests passed (\(device.name))")
